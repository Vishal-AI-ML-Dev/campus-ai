# Campus AI automated demo capture (e2e/demo-capture.spec.ts)
#
# Template only - copy to an UNTRACKED file and fill in your own values.
# No deployment URL, account or password is shipped with the repo.

# Local services by default. Use `localhost` for both (cookies are SameSite=Lax).
DEMO_BASE_URL=http://localhost:3000
DEMO_API_URL=http://localhost:8000

# Capture modes:
# - highlights: curated README/portfolio set
# - full: almost every implemented public + dashboard page
DEMO_CAPTURE_MODE=highlights

# Fresh test accounts you created yourself (e.g. via backend/scripts/seed_demo.py
# with your own DEMO_SEED_PASSWORD). Leave blank in this template.
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_TEACHER_EMAIL=
DEMO_TPO_EMAIL=
DEMO_STUDENT_EMAIL=
DEMO_RECRUITER_EMAIL=

# Default output is demo-assets-highlights or demo-assets-full.
# Override if needed:
# DEMO_OUTPUT_DIR=demo-assets
