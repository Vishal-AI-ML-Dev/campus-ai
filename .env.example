# Campus AI - Docker Compose local secrets (copy to .env; .env is gitignored).
# The whole stack boots WITHOUT these; they only enable the LLM-backed AI
# features (mentor chat, resume/ATS scoring) in the ai-worker.

# Which LLM backend: "groq" (fast free tier) or "gemini".
LLM_PROVIDER=groq

# Groq  -> https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini -> https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
