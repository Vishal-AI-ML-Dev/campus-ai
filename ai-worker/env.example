# Campus AI - AI Worker environment
# Copy this file to `.env` and fill in at least the provider you use.
# Location: ai-worker/.env (untracked). Placeholders only - never commit real keys.

# Which LLM backend to use: "groq" or "gemini"
LLM_PROVIDER=groq

# --- Groq (fast, free tier) -> https://console.groq.com/keys ---
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini -> https://aistudio.google.com/app/apikey ---
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: scoring consistency (0.0 - 1.0)
LLM_TEMPERATURE=0.2

# --- Vector store (Qdrant) -> shared by face attendance AND mentor career RAG ---
# Cloud:  QDRANT_URL=https://<your>.qdrant.io  + QDRANT_API_KEY=...
# Server: QDRANT_URL=http://127.0.0.1:6333
# Embedded (no server): leave QDRANT_URL empty -> on-disk folders are used.
QDRANT_URL=
QDRANT_API_KEY=

# Career-KB RAG (persistent Qdrant + local fastembed embeddings; no API key).
# RAG_COLLECTION=career_kb
# RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embedded-mode on-disk path (used only when QDRANT_URL is empty). Kept separate
# from the face store so both embedded stores never lock the same folder.
# RAG_QDRANT_LOCAL_PATH=qdrant_rag_data
