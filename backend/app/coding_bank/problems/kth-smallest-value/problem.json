  "title": "K-th Smallest Value",
  "difficulty": "medium",
  "topics": [
    "sorting_searching"
  ],
  "statement": "Given the marks of n students, print the k-th smallest mark (counting duplicates).",
  "input_format": "The first line contains n and k. The second line contains n integers.",
  "output_format": "Print the k-th smallest value.",
  "constraints": "1 ≤ k ≤ n ≤ 200000; 0 ≤ value ≤ 1000000000.",
  "examples": [
    {
      "input": "6 2\n7 10 4 3 20 15\n",
      "output": "4\n",
      "explanation": "Sorted: 3 4 7 10 15 20. The 2nd smallest is 4."
    }
  ],
  "visible_tests": [
    {
      "input": "6 2\n7 10 4 3 20 15\n",
