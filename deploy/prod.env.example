# Campus AI - production / staging environment MANIFEST (Phase 7).
#
# KEY NAMES ONLY. Never put real values in this file or in the repo. Real
# values live in the host's secret store (or an env file outside the repo,
# readable only by the deploy user) and are passed with --env-file.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use DIFFERENT values for staging and production.
#
# FORMAT RULE: comments go on their OWN line. Compose treats `KEY=  # note`
# as the literal value "# note" (a required secret would silently become the
# comment text). Required keys are left empty so compose refuses to start.

# ---------------------------------------------------------------- images
# [REQUIRED] registry/name@sha256:<digest> from the Phase 7 release build.
BACKEND_IMAGE=
# [REQUIRED]
AI_WORKER_IMAGE=
# [REQUIRED] built per environment (API origin + CSP baked in at build time).
FRONTEND_IMAGE=

# ---------------------------------------------------------------- database
# [REQUIRED] runtime role: NOBYPASSRLS, non-superuser.
# Shape: postgresql+psycopg://<app role>:<password>@<host>:5432/<db>
APP_DATABASE_URL=
# [REQUIRED for the migrate job only] table-owner role (not a superuser).
MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------- core secrets
# [REQUIRED] JWT signing key, >= 32 random characters.
SECRET_KEY=
# [REQUIRED] backend <-> ai-worker shared secret, >= 32 random characters.
AI_WORKER_TOKEN=

# ---------------------------------------------------------------- services
# [REQUIRED] Redis with auth (+ TLS where offered): rediss://:<password>@<host>:<port>/0
REDIS_URL=
# [REQUIRED] Qdrant server URL (the read-only ai-worker has no embedded fallback).
QDRANT_URL=
# Required for Qdrant Cloud / any authenticated Qdrant.
QDRANT_API_KEY=
# Optional; default http://ai-worker:7860 (same compose project).
AI_WORKER_URL=

# ---------------------------------------------------------------- edge / browser policy
# DECIDE WITH HOSTING - do not guess.
# [REQUIRED] exact frontend origin(s), comma-separated (also the CSRF allow-list).
CORS_ORIGINS=
# [REQUIRED] number of proxies that APPEND to X-Forwarded-For (0 = trust none).
TRUSTED_PROXY_HOPS=
# Empty = code default (production: SameSite=None + Secure). "lax" if the
# frontend and API end up on the same site.
COOKIE_SAMESITE=
# Empty = host-only cookie (recommended).
COOKIE_DOMAIN=
# 0 = off. Enable only when HTTPS-only on the final domain.
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
# Address the published ports listen on (reverse proxy on the same host).
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------- staging gate / metrics (Phase 7)
# Staging only: >= 32 random chars; the frontend's server-side /v1 proxy sends it.
STAGING_GATE_TOKEN=
# Dedicated bearer token for GET /metrics (>= 32 chars, different from every
# other secret). Empty = /metrics returns 404 in production.
METRICS_TOKEN=
# Worker's own metrics token (>= 32 chars, different from AI_WORKER_TOKEN).
AI_WORKER_METRICS_TOKEN=

# ---------------------------------------------------------------- AI governance (Phase 10.3, MANDATORY)
# Owner decisions D4 (Rs 0 AI budget) + OQ-2: production refuses to start
# unless AI_GOVERNANCE_ENABLED=true and both platform caps are positive
# integers. Set every cap BELOW the provider's verified free-tier limits.
AI_GOVERNANCE_ENABLED=true
# [REQUIRED] admitted AI requests per UTC day, all institutes together.
AI_PLATFORM_DAILY_REQUEST_MAX=
# [REQUIRED] provider-reported tokens per UTC day, all institutes together.
AI_PLATFORM_DAILY_TOKEN_MAX=
# Optional (empty = no cap): per institute per day; per student per day
# across mentor/resume/ATS.
AI_TENANT_DAILY_REQUEST_MAX=
AI_USER_DAILY_REQUEST_MAX=
# Simultaneous AI calls per backend process (D8 pilot: 3) and the wait for a slot.
AI_MAX_CONCURRENT_CALLS=3
AI_CONCURRENCY_WAIT_SECONDS=10
# Refuse new AI calls this long after the provider reports quota exhaustion.
AI_QUOTA_COOLDOWN_SECONDS=900
AI_IDEMPOTENCY_TTL_SECONDS=600
# Kill switches (operations). true = refuse EVERY new AI call.
AI_KILL_SWITCH=false
# Comma-separated subset of: mock_interview,mentor,resume,ats,proof_scoring
AI_DISABLED_FEATURES=
# ai-worker provider budget (MANDATORY in production): timeout 1-45 s,
# SDK retries 0 or 1 (each retry can repeat an LLM call).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# ---------------------------------------------------------------- AI circuit breaker / alerts (Phase 7.5)
# ON by default (approved exception P7-D4).
AI_CIRCUIT_ENABLED=true
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_ERROR_RATE=0.5
AI_CIRCUIT_MIN_CALLS=10
AI_CIRCUIT_WINDOW_SECONDS=120
AI_CIRCUIT_OPEN_SECONDS=60
AI_ALERT_THROTTLE_SECONDS=300

# ---------------------------------------------------------------- product feature flags (ALL default OFF)
# check_compose_prod.py fails if any of these is true without --approve <KEY>.
AI_MOCK_INTERVIEW_ENABLED=false
# Pilot allow-list of tenant ids (empty = every institute once enabled).
AI_MOCK_INTERVIEW_TENANT_IDS=
AI_MOCK_INTERVIEW_VOICE_ENABLED=false
AI_MOCK_INTERVIEW_VIDEO_ENABLED=false
# Empty = NO institute (fail closed).
AI_MOCK_INTERVIEW_VIDEO_TENANT_IDS=
AI_MOCK_INTERVIEW_CODING_ENABLED=false
# Empty = NO institute (fail closed).
AI_MOCK_INTERVIEW_CODING_TENANT_IDS=
# Development only; ignored in production. Keep false.
AI_MOCK_INTERVIEW_CODING_ALLOW_DRAFT_PROBLEMS=false
AI_MOCK_INTERVIEW_CODING_AI_ENABLED=false
AI_MOCK_INTERVIEW_COMPANY_ENABLED=false
AI_MOCK_INTERVIEW_OPS_ENABLED=false
# Platform ceilings for institute quotas ("" = no ceiling).
AI_MOCK_INTERVIEW_TENANT_MONTHLY_SESSION_MAX=
AI_MOCK_INTERVIEW_TENANT_MONTHLY_TOKEN_MAX=
AI_MOCK_INTERVIEW_UNREPORTED_TOKENS_ALERT_PERCENT=10
AI_MOCK_INTERVIEW_UNREPORTED_TOKENS_ALERT_MIN_CALLS=20
# Empty = cost "not configured". Never invent prices (P7-D9; D4 keeps it empty).
AI_PRICE_TABLE=
# Placement management v2 (Phase 9). Empty list = NO institute.
PLACEMENT_MANAGEMENT_ENABLED=false
PLACEMENT_MANAGEMENT_TENANT_IDS=
# Phase 10.5: browser error reports to the backend log/Sentry (content-free).
CLIENT_ERROR_REPORTING_ENABLED=false
# ai-worker route flags (must match the backend flags above).
MOCK_INTERVIEW_ENABLED=false
MOCK_INTERVIEW_CODING_ENABLED=false
MOCK_INTERVIEW_COMPANY_ENABLED=false
# ai-worker face recognition (biometric data). Disabled for the initial pilot
# and production (release decision B-8); never set true without separate approval.
FACE_ENABLED=false

# ---------------------------------------------------------------- optional (empty = disabled)
# Groq only for student data until OQ-3 (Gemini free-tier data terms) is
# verified: leave GOOGLE_API_KEY empty. Never add a billing method (D4).
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GOOGLE_API_KEY=
# File storage: a NEW project only - never the old compromised one.
SUPABASE_URL=
# Server-only key.
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=campus-uploads
SENTRY_DSN=
AI_WORKER_SENTRY_DSN=
ALERT_WEBHOOK_URL=
# D9 pending; recommendation OFF (leave both empty). Interview calls are never traced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Git commit of the deployed release (hex); shown by GET /version (gate G10).
BUILD_COMMIT=

# ---------------------------------------------------------------- frontend BUILD args
# Not runtime env - pass with `docker build --build-arg`:
#   NEXT_PUBLIC_API_BASE_URL   https://<api-host>
#   NEXT_PUBLIC_API_PREFIX     /v1
#   CSP_CONNECT_SRC_EXTRA      e.g. the storage origin used for signed uploads
#   HSTS_MAX_AGE               0
#   HSTS_INCLUDE_SUBDOMAINS    false   (never true on a shared platform domain such as vercel.app)
#   NEXT_PUBLIC_MOCK_INTERVIEW_ENABLED         false
#   NEXT_PUBLIC_MOCK_INTERVIEW_VIDEO_ENABLED   false
#   NEXT_PUBLIC_MOCK_INTERVIEW_CODING_ENABLED  false
#   NEXT_PUBLIC_MOCK_INTERVIEW_OPS_ENABLED     false
#   NEXT_PUBLIC_SENTRY_DSN                     (empty = frontend error tracking off; Phase 10.5)
